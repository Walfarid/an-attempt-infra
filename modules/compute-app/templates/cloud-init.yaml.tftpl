#cloud-config
package_update: true

packages:
  - curl
  - mysql-client

write_files:
  - path: /etc/systemd/system/walfa-bootstrap-db.service
    permissions: '0644'
    content: |
      [Unit]
      Description=walfa one-time managed-MySQL bootstrap (creates app database + user)
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/walfa-bootstrap-db.sh
      TimeoutStartSec=2700

      [Install]
      WantedBy=multi-user.target

runcmd:
  - command -v docker >/dev/null 2>&1 || curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  - usermod -aG docker ubuntu || true
  - mkdir -p /opt/walfa/secrets && chown -R ubuntu:ubuntu /opt/walfa
  - echo '${db_bootstrap_env_b64}' | base64 -d > /opt/walfa/secrets/db-bootstrap.env && chmod 600 /opt/walfa/secrets/db-bootstrap.env
  - echo '${bootstrap_script_b64}' | base64 -d > /usr/local/sbin/walfa-bootstrap-db.sh && chmod 700 /usr/local/sbin/walfa-bootstrap-db.sh
  - systemctl daemon-reload
  - systemctl enable --now walfa-bootstrap-db.service


final_message: "walfa app server ready after $${UPTIME} seconds"
