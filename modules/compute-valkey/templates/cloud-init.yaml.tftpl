#cloud-config
package_update: true

packages:
  - valkey-server

write_files:
  - path: /etc/systemd/system/walfa-bootstrap-valkey.service
    permissions: '0644'
    content: |
      [Unit]
      Description=walfa one-time Valkey bootstrap (configures valkey.conf)
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/walfa-bootstrap-valkey.sh
      TimeoutStartSec=300

      [Install]
      WantedBy=multi-user.target

runcmd:
  - echo '${valkey_env_b64}' | base64 -d > /opt/walfa/secrets/valkey.env && chmod 600 /opt/walfa/secrets/valkey.env
  - echo '${bootstrap_script_b64}' | base64 -d > /usr/local/sbin/walfa-bootstrap-valkey.sh && chmod 700 /usr/local/sbin/walfa-bootstrap-valkey.sh
  - systemctl daemon-reload
  - systemctl enable --now walfa-bootstrap-valkey.service

final_message: "walfa valkey server ready after $${UPTIME} seconds"