# walfa production environment - generated by Terraform, do not hand-edit.
# Deploy to: scp environments/prod/generated/walfa.env ubuntu@<app-ip>:/opt/walfa/.env

APP_IMAGE=${app_image}
DOMAIN=${domain}
ACME_EMAIL=${acme_email}

# --- Managed MySQL HeatWave (private subnet) ---
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_DATABASE=${db_name}
DB_USERNAME=${db_user}
DB_PASSWORD=${db_password}
MYSQL_CA_PATH=/opt/walfa/secrets/mysql-ca.pem

# --- Redis: valkey runs as a container in the app's docker-compose network ---
REDIS_HOST=valkey
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- OCI Object Storage via the S3-compatible API (media bucket) ---
FILESYSTEM_DISK=s3
AWS_ENDPOINT=${s3_endpoint}
AWS_BUCKET=${s3_bucket}
AWS_ACCESS_KEY_ID=${s3_access_key}
AWS_SECRET_ACCESS_KEY=${s3_secret_key}
AWS_DEFAULT_REGION=${region}
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Fill manually before first deploy: application secrets ---
WORKOS_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

APP_ENV=production
