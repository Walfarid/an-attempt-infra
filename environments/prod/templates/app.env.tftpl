# walfa production environment - generated by Terraform, do not hand-edit.
# Deploy to: scp environments/prod/generated/walfa.env ubuntu@<app-ip>:/opt/walfa/.env

APP_NAME=Walfa
APP_IMAGE=${app_image}
DOMAIN=${domain}
ACME_EMAIL=${acme_email}

APP_ENV=production
APP_KEY=${app_key}
APP_URL=https://${domain}
APP_DEBUG=false
SESSION_SECURE_COOKIE=true

# --- Managed MySQL HeatWave (private subnet) ---
DB_CONNECTION=mysql
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_DATABASE=${db_name}
DB_USERNAME=${db_user}
DB_PASSWORD=${db_password}
MYSQL_CA_PATH=/opt/walfa/secrets/mysql-ca.pem
MYSQL_ATTR_SSL_CA=/opt/walfa/secrets/mysql-ca.pem
# OCI MySQL serves a cert without a SAN; verify the CA chain, not the hostname.
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# --- Redis: valkey runs as a container in the app's docker-compose network ---
REDIS_HOST=valkey
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- OCI Object Storage via the S3-compatible API (media bucket) ---
FILESYSTEM_DISK=s3
AWS_ENDPOINT=${s3_endpoint}
AWS_BUCKET=${s3_bucket}
AWS_ACCESS_KEY_ID=${s3_access_key}
AWS_SECRET_ACCESS_KEY=${s3_secret_key}
AWS_DEFAULT_REGION=${region}
AWS_USE_PATH_STYLE_ENDPOINT=true
# Public media base URL served via Cloudflare (media.walfa.my.id -> proxied CNAME).
AWS_URL=${aws_public_url}
MEDIA_URL=${aws_public_url}

# --- WorkOS (AuthKit); the redirect URL must be whitelisted there too
#     (Authentication → Redirect URLs) ---
WORKOS_CLIENT_ID=${workos_client_id}
WORKOS_API_KEY=${workos_api_key}
WORKOS_REDIRECT_URL=https://${domain}/authenticate

# --- Cloudflare Turnstile ---
TURNSTILE_SITE_KEY=${turnstile_site_key}
TURNSTILE_SECRET_KEY=${turnstile_secret_key}

# --- Analytics ---
CLARITY_PROJECT_ID=${clarity_project_id}
GOOGLE_ANALYTICS_ID=${google_analytics_id}

# --- Ads.txt (served at /ads.txt; empty disables the route) ---
ADSTXT_CONTENT=${adstxt_content}

# --- Ezoic ads (single-post page only) ---
EZOIC_ENABLED=${ezoic_enabled}
EZOIC_PLACEHOLDER_ID=${ezoic_placeholder_id}
EZOIC_ADSTXT_MANAGER_ID=${ezoic_adstxt_manager_id}
